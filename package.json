{
  "name": "pastebin-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small persistent text-sharing app with expiry and atomic view limits.",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "build": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run build && npm test"
  }
}
