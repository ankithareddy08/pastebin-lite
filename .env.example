# No credentials are needed locally. Node.js 24 creates this database on startup.
STORAGE_DRIVER=sqlite
DATABASE_PATH=./data/pastes.sqlite
PORT=3000
TEST_MODE=0

# For Vercel: set STORAGE_DRIVER=redis and supply these in its environment settings.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Redis integration aliases KV_REST_API_URL and KV_REST_API_TOKEN also work.

# Optional canonical public origin. Leave blank to use the incoming request origin.
# APP_BASE_URL=
